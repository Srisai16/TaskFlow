# TaskFlow backend — copy to .env (or set as Render env vars). All optional; local dev/tests use H2 defaults.
# ---- Database (REAL DB) ----
# Render/Postgres (recommended, free): provisioned automatically by render.yaml -> taskflow-db
DB_URL=jdbc:postgresql://<host>:5432/taskflow?sslmode=require
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=taskflow
DB_PASSWORD=<postgres-password>
# MySQL alternative:
# DB_URL=jdbc:mysql://<host>:3306/taskflow
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# ---- Auth ----
# Long random string, >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-string>
JWT_EXPIRATION_MS=86400000
# ---- Datasource behavior ----
DB_DDL_AUTO=update
# ---- Server / CORS ----
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-frontend>.vercel.app